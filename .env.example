# Copy to .env and fill in real values. Never commit .env.

# --- Telegram / OpenAI ---
TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=

# --- Process role: which part of the bot this instance runs ---
# all      = receiver + worker in one process (use this for local dev)
# receiver = only polls Telegram and enqueues jobs (pin to exactly 1 instance)
# worker   = only processes queued turns (safe to run many)
ROLE=all

# --- Postgres (the conversation transcript) ---
# Local dev: docker compose up starts one at this address.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/telegram_bot

# --- Redis (the job queue) ---
REDIS_URL=redis://localhost:6379
QUEUE_SHARDS=16

# --- Models ---
OPENAI_MODEL=gpt-5.4-nano
OPENAI_SUMMARY_MODEL=gpt-5.4-nano
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Context budget (tokens) ---
CONTEXT_TOKEN_BUDGET=60000
SUMMARY_TRIGGER_MESSAGES=40
SUMMARY_KEEP_RECENT=20
